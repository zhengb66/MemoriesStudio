<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MemoriesStudio</AssemblyName>
    <RootNamespace>MemoriesStudio</RootNamespace>
    <!-- 关于对话框显示的版本号（ProductInfo.Version 读程序集元数据） -->
    <Version>0.7.1</Version>
    <FileVersion>0.7.1.0</FileVersion>
    <Product>Memories Studio</Product>
    <Company>郑兵</Company>
    <Copyright>Copyright © 2026 郑兵</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <!-- 剪辑对话框的视频/音频播放：LibVLC 自带全格式解码，不依赖系统 WMP 与 ffmpeg -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
