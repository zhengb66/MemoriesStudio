<Window x:Class="MemoriesStudio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Icon="/app.ico">
    <Border Margin="16" Padding="20,18,20,16" CornerRadius="8"
            Background="#1B1D24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/app.ico" Width="46" Height="46" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Memories Studio" FontSize="19" FontWeight="SemiBold" Foreground="#F3F5F9"/>
                    <TextBlock x:Name="TxtVersion" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TxtTagline" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                       Margin="0,18,0,0" Foreground="#C9CDD6"/>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="作者" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                <TextBlock x:Name="TxtAuthor" Grid.Column="1" FontSize="12" Foreground="#E4E7EE"/>
                <TextBlock Text="版权" Grid.Row="1" Margin="0,8,0,0"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                <TextBlock x:Name="TxtCopyright" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                           FontSize="12" Foreground="#E4E7EE"/>
            </Grid>

            <Button Content="确定" Style="{StaticResource AccentBtn}" Padding="22,6"
                    HorizontalAlignment="Right" Margin="0,18,0,0"
                    IsDefault="True" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Border>
</Window>
