<Window x:Class="MemoriesStudio.Views.FaceScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在人脸识别"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="18,16,18,14">
        <TextBlock Text="正在人脸识别（按识别结果自动取景运镜）"
                   FontSize="13.5" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="TxtInfo" Margin="0,8,0,10" FontSize="11.5"
                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                   Text="准备中…"/>
        <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100"/>
        <Button x:Name="BtnCancel" Content="取消" Click="OnCancel"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                Style="{StaticResource Btn}" Padding="22,4"/>
    </StackPanel>
</Window>
