<Window x:Class="MemoriesStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MemoriesStudio.Controls"
        Title="Memories Studio — 照片 / 视频记忆电影"
        Icon="pack://application:,,,/app.ico"
        Height="880" Width="1440" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        KeyDown="OnWindowKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSaveCommand"/>
    </Window.CommandBindings>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ======================= 顶部工具栏 ======================= -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Memories" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Studio" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0,14,0"/>
                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <Button x:Name="BtnNew" Content="新建" Style="{StaticResource Btn}" Margin="0,0,6,0" Click="OnNewProject"/>
                    <Button x:Name="BtnOpen" Content="打开" Style="{StaticResource Btn}" Margin="0,0,6,0" Click="OnOpenProject"/>
                    <Button x:Name="BtnSave" Content="保存" Style="{StaticResource Btn}" Margin="0,0,6,0" Click="OnSaveProject"
                            ToolTip="保存工程（Ctrl+S）"/>
                    <Button x:Name="BtnUndo" Style="{StaticResource IconBtn}" Margin="0,0,4,0"
                            ToolTip="撤销（最多 10 步）" Click="OnUndo" IsEnabled="False">
                        <Viewbox Width="16" Height="16">
                            <Path Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconBtn}" Margin="0,0,14,0"
                            ToolTip="重做" Click="OnRedo" IsEnabled="False">
                        <Viewbox Width="16" Height="16">
                            <Path Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtResBadge" Text="1920×1080 · 30fps" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11.5"/>
                    <TextBlock x:Name="TxtTotalBadge" Text="" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11.5"/>
                    <Button x:Name="BtnGlobalSettings" Content="设置" Style="{StaticResource Btn}" Margin="0,0,8,0"
                            Click="OnGlobalSettings" ToolTip="分辨率与帧率"/>
                    <Button x:Name="BtnExport" Content="导出 MP4" Style="{StaticResource AccentBtn}" Padding="18,6"
                            Click="OnExport"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= 主体三栏 ======================= -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <!-- 素材库 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,8">
                        <TextBlock Text="素材库" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAssetCount" Text="0 项" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                    </Grid>

                    <ListBox x:Name="AssetsList" Grid.Row="1" Style="{StaticResource TileList}" Margin="8,0,8,0"
                             SelectionMode="Extended" MouseDoubleClick="OnAssetDoubleClick"
                             PreviewMouseLeftButtonDown="OnAssetsListMouseDown" MouseMove="OnAssetsListMouseMove"/>

                    <StackPanel Grid.Row="2" Margin="8,8,8,10">
                        <UniformGrid Columns="2">
                            <Button x:Name="BtnImport2" Content="导入素材" Style="{StaticResource Btn}" Margin="0,0,3,0"
                                    Click="OnImportMedia" ToolTip="选择图片 / 视频文件加入素材库"/>
                            <Button x:Name="BtnAddSelectedToTimeline" Content="导入时间轴" Style="{StaticResource Btn}" Margin="3,0,0,0"
                                    Click="OnAddSelectedToTimeline" ToolTip="将选中的素材加入时间轴（等同双击素材）"/>
                        </UniformGrid>
                        <TextBlock x:Name="TxtDropHint" Text="也可以把文件或文件夹直接拖进窗口 · Ctrl 多选，Del 删除"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="10.5" Margin="2,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="1" Background="#08090B" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid x:Name="PreviewHost" SizeChanged="OnPreviewHostSizeChanged">
                        <Grid x:Name="PreviewRoot" Width="640" Height="360" Background="Black"
                              HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"
                              MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                              MouseLeftButtonUp="OnPreviewMouseUp" Cursor="Cross">
                            <Grid x:Name="HostA" ClipToBounds="True">
                                <Image x:Name="ImgA" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <Grid x:Name="HostB" ClipToBounds="True">
                                <Image x:Name="ImgB" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="FaceBox" Stroke="{StaticResource AccentBrush}"
                                           StrokeThickness="1.6" StrokeDashArray="3 2"
                                           RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="PreviewHint" Text="拖入素材开始创作"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#4A4D57" FontSize="15"/>

                    <Border x:Name="PreviewBadge" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                            Background="#B0000000" CornerRadius="3" Padding="7,3" Visibility="Collapsed">
                        <TextBlock x:Name="TxtPreviewBadge" Text="" FontSize="10.5" Foreground="#D6D9E0"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 属性面板 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0">
                <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <StackPanel>
                        <!-- 选中片段 -->
                        <TextBlock Text="选中素材" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TxtEmptyInspector" Text="在时间轴上点选一个片段（Ctrl 可多选）"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11.5" Margin="0,2,0,0"/>

                        <StackPanel x:Name="ClipPanel" Visibility="Collapsed">
                            <TextBlock x:Name="TxtClipName" Text="" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                            <!-- 片段操作：紧跟"选中素材"，不混入取景等属性分组 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="片段操作" Style="{StaticResource FieldLabel}"/>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <Button x:Name="BtnClipUp" Content="前移" Style="{StaticResource Btn}" Margin="0,0,4,0" Click="OnClipUp"/>
                                <Button x:Name="BtnClipDown" Content="后移" Style="{StaticResource Btn}" Margin="2,0,2,0" Click="OnClipDown"/>
                                <Button x:Name="BtnClipRemove" Content="删除" Style="{StaticResource Btn}" Margin="4,0,0,0" Click="OnRemoveClip"/>
                            </UniformGrid>
                            <!-- 仅图片片段可见：点一次顺时针旋转 90° -->
                            <Button x:Name="BtnClipRotate" Content="↻ 旋转 90°" Style="{StaticResource Btn}"
                                    Click="OnRotateClip" Visibility="Collapsed" Margin="0,0,0,12"
                                    ToolTip="把这张照片顺时针旋转 90°（每次点击叠加；预览与导出一致）"/>

                            <!-- 照片：显示时长可调 -->
                            <StackPanel x:Name="DurPanel">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="显示时长" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtClipDuration" Text="4.0s" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
                                </Grid>
                                <Slider x:Name="SldDuration" Style="{StaticResource FlatSlider}" Minimum="0.5" Maximum="20"
                                        SmallChange="0.1" ValueChanged="OnDurationChanged" Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- 视频：只显示长度信息，调整走「剪辑…」对话框 -->
                            <StackPanel x:Name="TrimPanel" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="原视频长度" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtTrimSrcLen" Text="—" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="11.5"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="剪辑后长度" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtTrimLen" Text="—" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
                                </Grid>
                                <Button x:Name="BtnTrimEdit" Content="剪辑…" Style="{StaticResource Btn}"
                                        Click="OnOpenTrimEditor" Margin="0,0,0,10"
                                        ToolTip="打开剪辑窗口：播放本段视频（有声），拖动区间条选择保留区间"/>
                                <TextBlock Text="点「剪辑…」打开播放窗口，拖动两侧把手选择起止点，中间圆点定位。"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10" Margin="0,0,0,10"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="转场" Style="{StaticResource FieldLabel}"/>
                            </Grid>
                            <ComboBox x:Name="CmbTransition" Style="{StaticResource Combo}" Margin="0,0,0,6"
                                      SelectionChanged="OnTransitionChanged"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="转场时长" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtTransitionDur" Text="1.0s" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            </Grid>
                            <Slider x:Name="SldTransition" Style="{StaticResource FlatSlider}" Minimum="0.2" Maximum="4"
                                    SmallChange="0.1" ValueChanged="OnTransitionDurationChanged" Margin="0,0,0,12"/>

                            <!-- 字幕：与片段绑定，导出时烧录进画面（图片单段 / 视频多段） -->
                            <StackPanel x:Name="CaptionPanel" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="字幕" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnCaptionAdd" Content="＋ 添加字幕" Style="{StaticResource Btn}"
                                                Padding="6,1" FontSize="10.5" Click="OnCaptionAdd"
                                                ToolTip="添加一段字幕（视频片段可加多段）"/>
                                        <Button x:Name="BtnCaptionDel" Content="删除" Style="{StaticResource Btn}"
                                                Padding="6,1" FontSize="10.5" Margin="4,0,0,0"
                                                Click="OnCaptionDelete" Visibility="Collapsed"
                                                ToolTip="删除当前编辑的这段字幕"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="LstCaptions" Height="72" Margin="0,0,0,6"
                                         Background="#14151A" BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1" FontSize="10.5" Padding="2"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="OnCaptionSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="2,3,0,3" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding RangeText, Mode=OneWay}" Foreground="#E8A33D"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Text, Mode=OneWay}" Foreground="#D6D9E0"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="CaptionEditor" Visibility="Collapsed">
                                    <TextBox x:Name="TxtCaption" AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                             VerticalScrollBarVisibility="Auto" FontSize="11.5"
                                             Background="#14151A" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="6,4"
                                             TextChanged="OnCaptionTextChanged" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="字号" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="TxtCaptionFont" Text="5%" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="SldCaptionFont" Style="{StaticResource FlatSlider}" Minimum="2" Maximum="12"
                                            SmallChange="0.2" ValueChanged="OnCaptionFontChanged" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="108"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbCaptionColor" Grid.Column="0" Style="{StaticResource Combo}"
                                                  SelectionChanged="OnCaptionStyleChanged"/>
                                        <ComboBox x:Name="CmbCaptionPos" Grid.Column="2" Style="{StaticResource Combo}"
                                                  SelectionChanged="OnCaptionStyleChanged"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="出现" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="TxtCaptionStart" Text="0.0s" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="SldCaptionStart" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="4"
                                            SmallChange="0.1" ValueChanged="OnCaptionStartChanged" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="消失" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="TxtCaptionEnd" Text="4.0s" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="SldCaptionEnd" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="4"
                                            SmallChange="0.1" ValueChanged="OnCaptionEndChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="FacePanel">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="取景" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtFaceStatus" Text="" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="10.5"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="主体类型" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="RbSubjectPortrait" Content="人像" GroupName="ClipSubject"
                                                     Checked="OnSubjectChanged" Foreground="{StaticResource TextBrush}"
                                                     FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     ToolTip="按人像取景：对准人脸并轻微推拉；识别错误时可在预览上单击校正中心"/>
                                        <RadioButton x:Name="RbSubjectScenery" Content="景物" GroupName="ClipSubject"
                                                     Checked="OnSubjectChanged" Foreground="{StaticResource TextBrush}"
                                                     FontSize="11" VerticalAlignment="Center"
                                                     ToolTip="按景物取景：不做人脸推拉（竖幅改为上下滑动）"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRedetectFace" Content="重新检测人脸" Style="{StaticResource Btn}"
                                            HorizontalAlignment="Right" Padding="6,1" FontSize="10.5"
                                            Click="OnRedetectFace" ToolTip="重新识别这张照片的人脸并生成取景运镜"/>
                                </Grid>
                                <TextBlock Text="取景中心由素材自动判定（有人对准人脸、无人对准主体），在预览画面上单击可手动调整；识别错误可直接指定「人像 / 景物」。" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="10.5" Margin="0,0,0,10"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 多选摘要 -->
                        <StackPanel x:Name="MultiPanel" Visibility="Collapsed">
                            <TextBlock x:Name="TxtMultiInfo" Text="" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="按住 Ctrl 可继续加选 / 取消选择；按 Del 删除所选片段。"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10.5" Margin="0,0,0,10"/>
                            <Button Content="删除所选片段" Style="{StaticResource Btn}" Click="OnRemoveSelectedClips"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
                        <TextBlock Text="背景音乐在顶部「设置」里添加；预览不播放声音，配乐与视频原声都在导出时合成。"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="10.5"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================= 播放控制 ======================= -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Margin="0,10,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPlay" Style="{StaticResource IconBtn}" Click="OnTogglePlay" ToolTip="播放 / 暂停">
                        <Path x:Name="PlayIcon" Data="{StaticResource IconPlayGeom}" Fill="{StaticResource TextBrush}"
                              Width="13" Height="13" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource IconBtn}" Margin="6,0,12,0" Click="OnStop" ToolTip="停止">
                        <Path Data="{StaticResource IconStopGeom}" Fill="{StaticResource TextBrush}"
                              Width="13" Height="13" Stretch="UniformToFill"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtTime" Text="00:00.0 / 00:00.0" VerticalAlignment="Center"
                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           Margin="0,0,14,0"/>
                <Slider Grid.Column="2" x:Name="SeekSlider" Style="{StaticResource FlatSlider}"
                        VerticalAlignment="Center" Minimum="0" Maximum="1" ValueChanged="OnSeekSliderChanged"/>
            </Grid>
        </Border>

        <!-- ======================= 时间轴 ======================= -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="12,0">
                    <TextBlock Text="时间轴" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTimelineInfo" Foreground="{StaticResource TextDimBrush}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="－" Style="{StaticResource Btn}" Padding="8,1" FontSize="11" Click="OnZoomOut"/>
                        <Button Content="＋" Style="{StaticResource Btn}" Padding="8,1" FontSize="11" Margin="4,0,0,0" Click="OnZoomIn"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              x:Name="TimelineScroll">
                    <ctrl:TimelineControl x:Name="Timeline" Height="130" MinWidth="400"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======================= 状态栏 ======================= -->
        <Border Grid.Row="4" Background="#101116" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
