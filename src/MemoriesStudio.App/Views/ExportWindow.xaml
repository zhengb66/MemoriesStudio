<Window x:Class="MemoriesStudio.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 MP4" Height="520" Width="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="输出设置" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbRes" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="帧率" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbFps" Grid.Column="3" Style="{StaticResource Combo}"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="画质" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbQuality" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="编码器" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbEncoder" Grid.Column="3" Style="{StaticResource Combo}"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="保存到" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtPath" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                         Background="{StaticResource Panel2Brush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" Padding="8,0" FontSize="11.5"/>
                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnBrowse"/>
            </Grid>
            <TextBlock x:Name="TxtSummary" Foreground="{StaticResource TextDimBrush}" FontSize="10.5" Margin="80,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

        <StackPanel Grid.Row="2">
            <ProgressBar x:Name="Bar" Height="6" Background="#2A2C35" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="TxtProgress" Text="准备就绪" Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#0E0F13" CornerRadius="5" Margin="0,12,0,0" Padding="10,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtLog" Foreground="#8A8D98" FontSize="10.5" FontFamily="Consolas"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BtnOpenFolder" Content="打开所在文件夹" Style="{StaticResource Btn}"
                    HorizontalAlignment="Left" Click="OnOpenFolder" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource Btn}" Width="88" Click="OnClose"/>
                <Button x:Name="BtnStart" Content="开始导出" Style="{StaticResource AccentBtn}" Width="112"
                        Margin="8,0,0,0" Click="OnStart"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
